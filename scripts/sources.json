  "antispam": {
    "_comment": "Patterns that strongly signal clickbait or low-value items. If matched in title, item is downgraded or dropped.",
    "drop_patterns": [
      "(?i)^\\s*(video|photos?|pictures?|en images?|gallery)\\s*:",
      "(?i)\\b(you won['’]t believe|shocking|wait until you see|incredible reaction)\\b",
      "(?i)\\?{2,}",
      "^[A-Z\\s!?]{30,}$"
    ],
    "clean_patterns": [
      [
        "(?i)^(breaking|alerte|alerta)\\s*:\\s*",
        ""
      ],
      [
        "(?i)^(video|vidéo|photos?)\\s*:\\s*",
        ""
      ],
      [
        "\\s+",
        " "
      ],
      [
        "[!]{2,}",
        "!"
      ],
      [
        "[\\.]{4,}",
        "..."
      ]
    ]
  }
