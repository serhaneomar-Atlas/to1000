# Bot-generated data files: on merge conflict, auto-resolve.
# These are regenerated by GitHub Actions (news-sync / stats-sync), so a human's
# local copy is never the source of truth. The "union"/"ours" strategy here stops
# git from dropping into an interactive merge / Vim every time a bot pushed first.
#
# NOTE: a custom merge driver ("theirs") must also be declared in git config:
#   git config merge.theirs.driver "cp -f %B %A"
# The scripts/setup-git.sh helper does this for you.

public/news.json            merge=theirs
public/stats.json           merge=theirs
public/translations_cache.json merge=theirs
public/sitemap.xml          merge=theirs
public/wc.json              merge=theirs
public/news/**              merge=theirs
